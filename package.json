{
  "name": "localclaude",
  "version": "1.0.0",
  "description": "Personal desktop app for Claude, powered by Claude Code and your Claude subscription. Data stays on this machine.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "test": "esbuild test/agent.test.ts --bundle --platform=node --format=esm --outfile=test/out/agent.test.mjs --alias:electron=./test/electron-stub.js --external:@anthropic-ai/claude-agent-sdk --log-level=warning && node test/out/agent.test.mjs"
  },
  "author": "Parthasarathy M",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "productName": "LocalClaude",
  "private": true,
  "type": "module",
  "desktopName": "localclaude.desktop"
}
